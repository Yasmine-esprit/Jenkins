pipeline {
    agent any

    stages {
        stage('Build') {
            steps {
                echo 'Building Spring Boot project...'
                dir('Student-Management')
                sh 'mvn clean compile'
            }
        }

        

    post {
        always {
            echo 'Cleaning workspace...'
            deleteDir()
        }
        success {
            echo 'Pipeline succeeded!'
        }
        failure {
            echo 'Pipeline failed!'
        }
    }
}
